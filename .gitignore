# PureScript / Spago
.pulp-cache/
output/
output-es/
generated-docs/
.psc-package/
.psc*
.purs*
.psa*
.spago/
node_modules/

# tramaj-cli bundle output
tramaj-cli/dist/

# Playground bundle output. Only the generated bundle — index.html and
# style.css in the same directory are source and stay tracked.
playground/dist/app.js
playground/dist/app.js.map

# Kitchen-Sink site build output. website/src/ is source and stays tracked.
website/www/

# Playground bundle copied into the website by
# website/scripts/sync-playground.sh — mechanical output, not source.
website/src/tramaj-playground.html
website/src/tramaj-playground-app.js
website/src/tramaj-playground.css

# Reference pages generated from specs/*.md by
# website/scripts/sync-reference.sh — mechanical output, not source.
website/src/reference-language.cmark
website/src/reference-node-json.cmark
website/src/reference-v3-symbols.cmark
website/src/reference-v4-types.cmark

# Haskell / Cabal
dist-newstyle/
*.hi
*.o
cabal.project.local
cabal.project.local~

# Stray trace output from an MCP agent server run in this directory — not
# produced by anything in this repository.
agents-logfile
agents/memory.db-shm
conv.*.json
