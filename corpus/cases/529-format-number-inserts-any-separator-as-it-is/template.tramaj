-- reference.md §11, Number formatting: nothing validates the separator
[format-number(1234567, 0, " "),
 format-number(1234567, 0, "'"),
 format-number(1234567, 0, "_"),
 format-number(1234567.891, 2, "."),
 format-number(1234567, 0, " | "),
 format-number(1234567, 0, "0"),
 format-number(1234567, 1, "-")]
