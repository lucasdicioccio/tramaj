                },
                {
                  "tag": "DirectoryRecursive",
                  "contents": "./tramaj"
                },
                {
                  "tag": "DirectoryRecursive",
                  "contents": "./tramaj-cli"
                },
                {
                  "tag": "DirectoryRecursive",
                  "contents": "./tramaj-halogen"
                },
                {
                  "tag": "DirectoryRecursive",
