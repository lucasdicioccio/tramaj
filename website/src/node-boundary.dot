digraph node_boundary {
  rankdir=LR;
  graph [bgcolor="#ffffff", pad=0.3, fontname="Helvetica", nodesep=0.4, ranksep=0.55];
  node  [shape=box, style="rounded,filled", fillcolor="#f3f1ec", color="#8d867a", fontname="Helvetica", fontsize=12, fontcolor="#1c1b19"];
  edge  [color="#514d46", fontname="Helvetica", fontsize=10, fontcolor="#514d46"];

  in  [label="program\n+ context\n+ library table", shape=note];
  ev  [label="evaluator\ndeterministic:\nsame inputs, same Node", fillcolor="#e8ecfb", color="#3a5fd9"];
  nj  [label="Node JSON\nscalars stay scalars,\nactions are opaque data", fillcolor="#e8ecfb", color="#3a5fd9"];
  h1  [label="Halogen fold"];
  h2  [label="React fold"];
  h3  [label="your fold"];
  act [label="host action table\nkey -> handler", fillcolor="#fbeee8", color="#c0562f"];

  in -> ev;
  ev -> nj [label="portable\nboundary"];
  nj -> h1;
  nj -> h2;
  nj -> h3;
  h1 -> act [style=dashed, label="action key"];
  h2 -> act [style=dashed];
  h3 -> act [style=dashed];
}
