{
  "name": "tramaj-js",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript port of the Tramaj language: parser, evaluator, normative Node JSON, and static analysis. No React or DOM dependency.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
